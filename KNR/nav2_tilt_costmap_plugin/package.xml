<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav2_tilt_costmap_plugin</name>
  <version>1.0.0</version>
  <description>Run-time plugin for Costmap2D mesh later</description>
  <maintainer email="michal11paradowski@gmail.com">Michał Paradowski</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <export>
    <costmap_2d plugin="${prefix}/tilt_layer.xml" />
    <build_type>ament_cmake</build_type>
  </export>
</package>